# Personal exports / backups (never commit real account rules)
*-profiles.json
*-settings.json
gilad-*.json
!examples/

# Build artifacts
/dist/
/web-ext-artifacts/
*.zip
*.xpi
.amo-upload-uuid

# Node tooling (web-ext only; the extension itself has no runtime deps)
node_modules/

# Environment / secrets
.env
.env.*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
!.vscode/extensions.json
*.sublime-workspace
.project
.classpath
.c9/
*.launch
.settings/

# Dropbox / sync noise
*.icloud
* 2
* 2.*

# Local AI-assistant configuration. Kept out of the repo; not part of the extension.
# Written as .claude/* rather than .claude/ on purpose: git cannot re-include a
# file whose parent directory is excluded, and the line below must work.
.claude/*
# ...except the record that this project has no deployed surface, which the
# pre-push drift check reads and which must survive a fresh clone.
!.claude/deploy-targets.json

# Cursor / local agent (not part of the extension)
.cursor/
agent-transcripts/
agent-tools/
